# ===========================================================================
# SetPlay — Environment Variables
# Copy this file to .env.local for local development overrides.
#
# Secrets for production should be set via Wrangler:
#   pnpm wrangler secret put SECRET_NAME
# ===========================================================================

# Cloudflare (for Drizzle Kit migrations via drizzle.config.ts)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Twitch API (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# start.gg API (https://developer.start.gg)
STARTGG_API_TOKEN=

# Web Push / VAPID keys
# Generate with: pnpm web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Admin access token (any strong random string)
# Used to protect /admin/* routes
ADMIN_TOKEN=
